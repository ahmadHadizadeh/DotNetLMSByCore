<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.Facebook" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.15" />

    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.15" />

    <PackageVersion Include="HtmlSanitizer" Version="11.0.26" />
    <PackageVersion Include="SharpCompress" Version="0.50.9" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />

    <!-- Temporary compatibility dependency; replace with a cross-platform image processor in Phase 1A. -->
    <PackageVersion Include="System.Drawing.Common" Version="10.0.15" />
  </ItemGroup>
</Project>
