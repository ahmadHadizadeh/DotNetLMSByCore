@model IEnumerable<DataLayer.Course.CourseEpisode>
@{
    ViewData["Title"] = "جزئیات بخش های دوره";
    int row = 1;
}

<partial name="_HeaderUserpanel" />
<section class="mt-5 pt-4">
    <div class="container">
        <div class="row">
            <partial name="_SidBar" />
            <div class="col-lg-8 col-md-10 col-sm-10 mt-5 col-10 d-sm-block">
                <div class="rounded shadow p-4 mt-1">
                        <div class="section-title text-center mb-4 pb-2">
                            <div class="title mb-4">
                                <a asp-action="AddEpisode" asp-controller="Teacher" asp-route-courseId="@ViewBag.courseid" class="btn btn-outline-info mt-2 me-2"> ایجاد دوره جدید</a>
                            </div>
                        </div>
                    <div class="table-responsive bg-white shadow-md rounded-md mb-3">
                        <table class="table mb-0 table-center" style="direction: rtl">
                            <thead>
                            <tr>
                                <th scope="col" class="border-bottom">ردیف</th>
                                <th scope="col" class="border-bottom text-center" style="min-width: 250px;">عنوان </th>
                                <th scope="col" class="border-bottom" style="width: 100px;">زمان</th>
                                <th scope="col" class="border-bottom" style="width: 150px;">وضعیت </th>
                                <th scope="col" class="border-bottom" style="width: 150px;"> فایل</th>
                            </tr>
                            </thead>
                            <tbody>
                            @if (Model.Any())
                            {
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@row</td>
                                        <td>
                                            <p class="text-center">@item.EpisodeTitle</p>
                                        </td>
                                        <td>
                                            <p class="text-center">@item.EpisodeTime</p>
                                        </td>
                                        <td>
                                            @if (item.IsFree)
                                            {
                                                <p class="text-success">رایگان</p>
                                            }
                                            else
                                            {
                                                <p class="text-center text-danger">نقدی </p>
                                            }

                                        </td>
                                        <td>
                                            <a class="btn btn-info text-center" asp-action="DownloadFile"asp-controller="Course"asp-route-episodId="@item.EpisodeId"> دانلود </a>
                                        </td>
                                    </tr>
                                    row += 1;
                                }
                            }
                            else
                            {
                                <tr class="text-center text-muted alert-warning p-2">هیچ بخش جدید یافت نشد</tr>
                            }
                            </tbody>
                        </table><!--end table-->
                    </div>
                </div>
            </div><!--end col-->
        </div>
    </div>
    <!--end container-->
</section>





