@model Core.DTO.AddEpisodeTeacherViewModel
@{
    ViewData["Title"] = "افزودن قسمت جدید";
    int row = 1;
}

<partial name="_HeaderUserpanel" />
<section class="mt-5 pt-4">
    <div class="container">
        <div class="row">
            <partial name="_SidBar" />
            <div class="col-lg-8 col-md-10 col-sm-10 mt-5 col-10 d-sm-block">
                <div class="rounded shadow p-4 mt-1">
                    <div class="section-title text-center mb-4 pb-2">
                        <h1 class="title mb-4">@ViewData["Title"]</h1>
                    </div>
                    <form asp-action="AddEpisode" asp-controller="Teacher" method="post" enctype="multipart/form-data">
                        <input type="hidden" asp-for="CourseId" />
                        <input type="hidden" asp-for="EpisodeFileName" />
                        <div class="row">
                            <div class="col-md-6 col-sm-12 col-xs-12">
                                <div class="input-group ">
                                    <div class="form-icon  position-relative">
                                        <span class="input-group-addon"><i class="zmdi zmdi-file-text"></i></span>
                                        <input type="text" class="form-control ps-5" asp-for="EpisodeTitle" placeholder="عنوان جلسه">
                                    </div>
                                    <span class="text-danger" asp-validation-for="EpisodeTitle"></span>
                                </div>
                            </div>
                            <div class="col-md-6 col-sm-12 col-xs-12">
                                <div class="input-group">
                                    <div class="form-icon position-relative">
                                        <input  type="text" class="form-control  ps-5" asp-for="EpisodeTime" placeholder="0 0 : 0 0: 0 0">
                                    </div>
                                    <span class="text-danger" asp-validation-for="EpisodeTime"></span>
                                </div>
                            </div>
                            <div class="form-group">
                                <div class="checkbox">
                                    <label>
                                        <input type="checkbox" asp-for="IsFree">
                                        رایگان است
                                    </label>
                                </div>
                            </div>
                            <div data-url="@Url.Action("DropzoneTarget", "Teacher", new {courseId = Model.CourseId})" class="dropzone mt-4" id="my-dropzone">
                                <div class="fallback">
                                    <input name="files" type="file" multiple />
                                </div>
                                <div class="dz-message">
                                    <i class="zmdi zmdi-upload"></i>
                                    <span>فایل خود را انتخاب و یا به داخل جعبه بیندازید</span>
                                </div>
                            </div>
                        </div>
                        <div class="row m-4 justify-content-end">
                            <div class="col-12 text-center">
                                <button id="SubmitBtn" class="btn btn-success"> ثبت قسمت جدید </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div><!--end col-->
        </div>
    </div>
    <!--end container-->
</section>

@section Scripts{
    <script>
        function DropzoneParameterName() {
            return 'files';
        }

        Dropzone.options.myDropzone = {
            url: $("#my-dropzone").attr("data-url"),
            headers: {
                "RequestVerificationToken": document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? ""
            },
            parallelUploads: 1,
            uploadMultiple: true,
            maxFilesize: 100,
            paramName: DropzoneParameterName,
            maxFiles: 1,
            acceptedFiles: '.rar,.zip',
            init: function () {
                this.on("errormultiple",
                    function (file, message) {
                        swal("Error", message, "error");
                    });
                this.on("sendingmultiple",
                    function (file) {
                        $("#SubmitBtn").prop("disabled", true);
                    });
                this.on("queuecomplete",
                    function (file) {
                        $("#SubmitBtn").prop("disabled", false);
                    });
                this.on("successmultiple",
                    function (file, response) {
                        if (response.status === "Success") {
                            $("#EpisodeFileName").val(response.data);
                        } else {
                            swal("Error", "عملیات با خطا مواجه شد .", "error");
                        }
                    });
                this.on("maxfilesreached",
                    function (file) {
                        this.removeEventListeners();
                    });
            }
        }
    </script>
}
