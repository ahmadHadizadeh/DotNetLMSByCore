@model Core.DTO.ChangPasswordviewModel
@{ ViewData["Title"] = "تغییر رمز عبور"; }

<partial name="_HeaderUserpanel" />
<section class="section mt-60">
    <div class="container mt-lg-3">
        <div class="row">
            <partial name="_SidBar" />
            <div class="col-lg-8 col-12">
                <div class="card border-0 rounded shadow">
                    <h5 class="text-md-start text-center pr-2"> تغییر رمز عبور:</h5>
                    <div class="card-body">
                        @if (ViewBag.IsSuccess != null)
                        {
                            <div class="alert alert-success">
                                <p class="text-center">
                                    کاربر عزیز کلمه عبور شما با موفقیت ویرایش شد
                                </p>
                            </div>

                        }

                        <form asp-action="ChangePassword" method="post">
                            <div class="col-md-6 mt-4 pt-2">
                                <div class="row mt-4">
                                    <div class="col-lg-12">
                                        <div class="mb-3">
                                            <label class="form-label">رمز عبور قدیمی : </label>
                                            <div class="form-icon position-relative">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-key fea icon-sm icons"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"></path></svg>
                                                <input type="password" class="form-control ps-5" asp-for="OldPassword" placeholder="رمز قدیمی" required="">
                                            </div>
                                        </div>
                                    </div><!--end col-->

                                    <div class="col-lg-12">
                                        <div class="mb-3">
                                            <label class="form-label">رمز عبور جدید : </label>
                                            <div class="form-icon position-relative">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-key fea icon-sm icons"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"></path></svg>
                                                <input type="password" class="form-control ps-5" asp-for="Password" placeholder="رمز جدید" required="">
                                            </div>
                                        </div>
                                    </div><!--end col-->

                                    <div class="col-lg-12">
                                        <div class="mb-3">
                                            <label class="form-label">تایید رمز عبور جدید : </label>
                                            <div class="form-icon position-relative">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-key fea icon-sm icons"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"></path></svg>
                                                <input type="password" class="form-control ps-5" asp-for="RePassword" placeholder="رمز عبور جدید" required="">
                                            </div>
                                        </div>
                                    </div><!--end col-->
                                    <div asp-validation-summary="All" class="text-danger"></div>

                                    <div class="col-lg-12 mt-2 mb-0">
                                        <button type="submit" class="btn btn-primary">ذخیره رمز عبور </button>
                                    </div><!--end col-->
                                </div><!--end row-->

                            </div>

                        </form><!--end form-->


                    </div>
                </div>

            </div>
        </div>
    </div>
</section>

