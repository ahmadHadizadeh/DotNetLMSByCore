@page
@using Core.Convertors
@model Asancode.Web.Pages.Admin.Course.ListDeleteCourseModel
@{
    ViewData["Title"] = "ListDeleteCourse";
}
<div class="row">
    <div class="col-lg-12">
        <h1 class="page-header alert alert-warning ">لیست  دوره های حذف شده </h1>
    </div>
    <!-- /.col-lg-12 -->
</div>
<div class="col-lg-12">
    <div class="panel panel-info">
        <div class="panel-heading">
            حذف دوره
        </div>
        <!-- /.panel-heading -->
        <div class="panel-body">
            <div class="table table-responsive">
                <div id="dataTables-example_wrapper" class="dataTables_wrapper form-inline" role="grid">
                    <div class="row">
                        <form>
                            <div class="col-md-5 col-sm-5">
                                <input name="filterCourseName" class="form-control" type="text" placeholder="لطفا نام دوره مورد نظر را وارد کنید" />
                            </div>
                            <div class="col-md-2 col-sm-2">
                                <button class="btn btn-success"> جستجو</button>
                                <a href="/Admin/Course/ListDeleteCourse" class="btn btn-warning"> Clear Filter</a>
                                <a href="/Admin/Course/Index" class="btn btn-primary">افزودن دوره</a>
                            </div>
                        </form>
                        <div class="col-md-12 col-sm-9 justify-content-center" style="padding: 15px 15px 10px 0;">
                        </div>
                        <table class="table table-bordered table-striped table-hover table-responsive">
                            <thead>
                                <tr>
                                    <th>نام دوره</th>
                                    <th>تاریخ</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var course in Model.AdminCourseViewModel.Course)
                                {
                                    <tr>
                                        <td>@course.CourseTitle</td>
                                        <td>@course.CreateDate.ToShamci()</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <div class="row">
                            <div class="col-sm-6 text-left ">
                                <div class="dataTables_paginate">
                                    <ul class="pagination">
                                        @for (int i = 1; i <= Model.AdminCourseViewModel.PageCount; i++)
                                        {
                                            <li class="paginate_button @((i == Model.AdminCourseViewModel.CurrentPage) ? "active" : "")">
                                                <a href="/Admin/Course/ListDeleteCourse?pageId=@i">@i</a>
                                            </li>

                                        }
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- /.table-responsive -->
            </div>
            <!-- /.panel-body -->
        </div>
        <!-- /.panel -->
    </div>
</div>
