@page "{id}"
@using Core.Convertors
@model Asancode.Web.Pages.Admin.Course.DeleteCourseModel
@{
    ViewData["Title"] = "حذف دوره";
}
<div class="row">
    <div class="col-lg-12">
        <h1 class="page-header alert alert-warning">حذف دوره آموزشی</h1>
    </div>
</div>
<div class="container">
    <div class="row">
        <div class="col-md-11 col-sm-12">
            <form method="post">
                <input type="hidden" name="CourseId" value="@ViewData["CourseId"].ToString()" />
                <ul class="list-group">
                    <li class="list-group-item"> نام دوره:@Model.InfoCourseViewModel.Title</li>
                    <li class="list-group-item">تاریخ:@Model.InfoCourseViewModel.CreateDate.ToShamci()</li>
                </ul>
                <div class="row">
                    <div class="col-md-8 col-sm-10">
                        <input type="submit" class="btn btn-danger" value="حذف" />
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
