@page "{id}"
@model Asancode.Web.Pages.Admin.Course.IndexEpisodeModel
@{
    ViewData["Title"] = "لیست بخش";
    int row = 1;
}
<div class="row">
    <div class="col-lg-12">
        <h1 class="page-header alert alert-warning ">لیست بخش ها</h1>
    </div>
    <!-- /.col-lg-12 -->
</div>
<div class="col-lg-12">
    <div class="panel panel-info">
        <div class="panel-heading">
            لیست بخش ها
        </div>
        <!-- /.panel-heading -->
        <div class="panel-body">
            <div class="table table-responsive">
                <div id="dataTables-example_wrapper" class="dataTables_wrapper form-inline" role="grid">
                    <div class="row">
                        <div class="col-md-10">
                            <a asp-page="CreateEpisode" asp-route-id="@ViewData["CourseId"].ToString()" class="btn btn-outline btn-success"> ایجاد بخش جدید</a>
                        </div>
                    </div>
                </div>
            </div>
            <table class="table table-bordered table-striped table-hover ">
                <thead>
                    <tr>
                        <th>ردیف</th>
                        <th> عنوان بخش</th>
                        <th>زمان بخش</th>
                        <th>رایگان</th>
                        <th>عمیلات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.CourseEpisodes)
                    {
                        <tr>
                            <td>@row</td>
                            <td>@item.EpisodeTitle</td>
                            <td>@item.EpisodeTime</td>
                            <td>
                                @if (item.IsFree)
                                {
                                    <span class="text-success">
                                        <i class="glyphicon glyphicon-ok"></i>
                                    </span>
                                }
                                else
                                {
                                    <span class="text-danger">
                                        <i class="glyphicon glyphicon-remove"></i>
                                    </span>
                                }
                            </td>
                            <td>
                                <a class="btn btn-group-sm btn-sm btn-warning" href="/Admin/Course/EditEpisode/@item.EpisodeId">و یرا یش</a>
                                <a class="btn btn-group-sm btn-sm btn-danger" href="/Admin/Course/DeleteEpisode/@item.EpisodeId">حذف این بخش</a>
                                @*<a asp-page="DeleteEpisode" asp-route-id="@ViewData["CourseId"].ToString()" class="btn btn-outline btn-danger"> حذف این بخش</a>*@
                            </td>
                        </tr>
                        row += 1;
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
