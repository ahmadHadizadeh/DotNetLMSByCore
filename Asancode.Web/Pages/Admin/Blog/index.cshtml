@page
@using Core.DTO
@model Asancode.Web.Pages.Admin.Blog.IndexModel
@{
    ViewData["Title"] = " مقاله های برنامه نویسی";
}
<div class="row">
    <div class="col-lg-12">
        <h1 class="page-header alert alert-warning ">لیست  مقاله ها</h1>
    </div>
</div>
<div class="col-lg-12">
    <div class="panel panel-info">
        <div class="panel-heading">
            لیست  مقاله ها
        </div>
        <!-- /.panel-heading -->
        <div class="panel-body">
            <div class="table table-responsive">
                <div class="dataTables_wrapper form-inline" role="grid">
                    <div class="row">
                        <div class="col-md-10">
                            <a href="/Admin/Blog/CreateBlog" class="btn btn-outline  btn-success"> ایجاد مقاله جدید</a>
                        </div>
                    </div>
                </div>
            </div>
            <table class="table table-bordered table-striped table-hover ">
                <thead>
                <tr>
                    <th >تصویر مقاله </th>
                    <th> عنوان مقاله</th>
                    <th>نویسنده مقاله</th>
                    <th>عمیلات</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.BlogViewModel.Blog)
                {
                    <tr>
                        <td><img src="/Blog/Thumnail/@item.BlogImageName" class="thumbnail" style="width: 190px" /></td>
                        <td>@item.Title</td>
                        <td>@item.Writer</td>
                        <td>
                            <a class="btn btn-group-sm btn-sm btn-warning" href="/Admin/Blog/EditBlog/@item.BlogId">و یرا یش</a>
                            <a class="btn btn-group-sm btn-sm btn-danger" href="/Admin/Blog/DeleteBlog/@item.BlogId">حذف مقاله</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
            <div class="row">
                <div class="col-sm-6 text-left ">
                    <div class="dataTables_paginate">
                        <ul class="pagination">
                            @for (int i = 1; i <=Model.BlogViewModel.PageCount; i++)
                            {
                                <li class="paginate_button @((i == Model.BlogViewModel.CurrentPage) ? "active" : "")" aria-controls="dataTables-example" tabindex="0">
                                    <a href="/Admin/Blog?pageId=@i">@i</a>
                                </li>

                            }
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
