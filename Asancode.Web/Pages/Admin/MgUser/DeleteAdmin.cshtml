@page "{id}"
@using Core.Convertors
@model Asancode.Web.Pages.Admin.MgUser.DeleteAdminModel
@{
    ViewData["Title"] = "DeleteAdmin";
}
<div class="row">
    <div class="col-lg-12">
        <h1 class="page-header alert alert-warning ">حذف کاربر</h1>
    </div>
    <!-- /.col-lg-12 -->
</div>
<div class="container">
    <div class="row">
        <div class="col-md-11 col-sm-12">
            <form method="post">
                <input type="hidden" name="UserId" value="@ViewData["UserId"].ToString()" />
                <ul class="list-group">
                    <li class="list-group-item"> نام کاربری:@Model.InformationUserPanelViewModel.UserName</li>
                    <li class="list-group-item">  ایمیل :@Model.InformationUserPanelViewModel.Email</li>
                    <li class="list-group-item">   تاریخ: @Model.InformationUserPanelViewModel.RegisterDate.ToShamci()</li>
                    <li class="list-group-item">کیف پول:  @Model.InformationUserPanelViewModel.Wallet</li>
                </ul>
                <div class="row">
                    <div class="col-md-8 col-sm-10">
                        <input type="submit" class="btn btn-danger" value=" حذف کاربر" />
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
