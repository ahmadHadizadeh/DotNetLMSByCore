@page "{handler?}"
@model Asancode.Web.Pages.Admin.Discount.CreateDiscountModel
@{
    ViewData["Title"] = "CreateDiscount";
}
<div class="row">
    <div class="col-lg-12">
        <h1 class="page-header alert alert-warning text-center ">افزودن کد تخفیف</h1>
    </div>
    <!-- /.col-lg-12 -->
</div>
<div class="container">
    <form method="post">
        <div class="row">
            <div class="col-md-5 col-md-offset-3">
                <div class="form-group">
                    <label> کد تخفیف:</label>
                    <input class="form-control" type="text" asp-for="Discount.DiscountCode" />
                    <div class="alert alert-danger" id="AlertCode" style="display: none;">
                        <p class="text-center text-info">کد وارد شده معتبر نمی باشد </p>
                    </div>
                </div>
                <div class="form-group">
                    <label> درصد تخفیف :</label>
                    <input class="form-control" type="number" asp-for="Discount.Percent" />
                </div>
                <div class=" form-group">
                    <label> تعداد تخفیف:</label>
                    <input class="form-control" type="number" asp-for="Discount.Count" />
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-2 col-md-offset-3 ">
                <div class="form-group">
                    <label> تاریخ شروع:</label>
                    <div class="input-group">
                        <span class="input-group-addon"><i class="glyphicon glyphicon-calendar"></i></span>
                        <input type="text" id="startDt" name="startDt" class="form-control" placeholder="تاریخ شروع">
                    </div>
                </div>
            </div>
            <div class="col-md-2  ">
                <div class="form-group">
                    <label> تاریخ پایان:</label>
                    <div class="input-group">
                        <span class="input-group-addon"><i class="glyphicon glyphicon-calendar"></i></span>
                        <input type="text" id="endtDt" name="endtDt" class="form-control" placeholder="تاریخ پایان">
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4 col-md-offset-3 " style="margin-top: 40px;  padding: 10px;">
            <input type="submit" value="ذخیره اطلاعات" class="btn btn-success btn-block " />
        </div>
    </form>
</div>
@section Scripts
    {
    <script>
        $("#Discount_DiscountCode").blur(function () {
            $.ajax({
                type: "get",
                url: "/Admin/Discount/CreateDiscount/CheckCode?code=" + $("#Discount_DiscountCode").val()
            }).done(function (res) {
                if (res === 'True') {
                    $("#AlertCode").show();

                } else {
                    $("#AlertCode").hide();
                }
            });
        });

    </script>
    <script src="/DateTimPickr/js/jquery-1.10.1.min.js"></script>
    <script src="/DateTimPickr/js/persianDatepicker.min.js"></script>
    <script type="text/javascript">
        $(function () {
            $("#startDt").persianDatepicker();
            $("#endtDt").persianDatepicker();
        });
    </script>
}
