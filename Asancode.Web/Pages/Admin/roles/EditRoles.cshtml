@page "{id}"
@using DataLayer.Entities.Permission
@model Asancode.Web.Pages.Admin.roles.EditRolesModel
@{
    ViewData["Title"] = "EditRoles";
    List<Permission> permissions = ViewData["SelectPermission"] as List<Permission>;
}
<div class="row">
    <div class="col-lg-12">
        <h1 class="page-header alert alert-warning ">ویرایش  نقش ها</h1>
    </div>
    <!-- /.col-lg-12 -->
</div>
<div class="container">
    <div class="row">
        <form method="post">
            <div class="col-md-8 col-sm-9 form-group">
                <div class="panel panel-info">
                    <div class="panel-heading">
                        ویرایش  نقش ها
                    </div>
                    <input hidden asp-for="Roles.RoleId" />
                    <input hidden asp-for="Roles.IsDelete" />
                    <div class="panel-body">
                        <input class="form-control" type="text" asp-for="Roles.RolesTitles" placeholder="عنوان نقش ها" />
                    </div>
                </div>
            </div>
            <div class="col-md-4 col-sm-4">
                <div class="panel panel-info">
                    <div class="panel-heading">
                        دسترسی ها

                    </div>
                    @{
                        List<int> ShowSelectpermission = ViewData["ShowSelectPermission"] as List<int>;
                    }
                    <div class="panel-body">
                        <div id="listrole">
                            <ul>
                                @foreach (var permission in permissions.Where(p => p.ParentID == null))
                                {
                                    <li>
                                        <input type="checkbox" name="SelectPermission" @((ShowSelectpermission.Any(p => p == permission.PermissionId) ? "Checked" : "")) value="@permission.PermissionId" />       @permission.PermissionTitle
                                        @if (permissions.Any(p => p.ParentID == permission.ParentID))
                                        {
                                            <ul>
                                                @foreach (var sub1 in permissions.Where(p => p.ParentID == permission.PermissionId))
                                                {
                                                    <li>
                                                        <input type="checkbox" name="SelectPermission" @((ShowSelectpermission.Any(p => p == sub1.PermissionId) ? "Checked" : "")) value="@sub1.PermissionId" />         @sub1.PermissionTitle
                                                    </li>
                                                    @if (permissions.Any(p => p.ParentID == sub1.ParentID))
                                                    {
                                                        <ul>
                                                            @foreach (var sub2 in permissions.Where(p => p.ParentID == sub1.PermissionId))
                                                            {
                                                                <li>
                                                                    <input type="checkbox" name="SelectPermission" @((ShowSelectpermission.Any(p => p == sub2.PermissionId) ? "Checked" : "")) value="@sub2.PermissionId" />     @sub2.PermissionTitle
                                                                </li>
                                                            }
                                                        </ul>
                                                    }

                                                }
                                            </ul>
                                        }
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <input type="submit" value="ثبت اطلا عات" class="btn btn-success" />
                </div>
            </div>
        </form>
    </div>
</div>
