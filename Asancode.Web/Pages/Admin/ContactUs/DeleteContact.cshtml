@page "{id}"
@model Asancode.Web.Pages.Admin.ContactUs.DeleteContactModel
@{
    ViewData["Title"] = "DeleteContact";
}
<div class="row">
    <div class="col-lg-12">
        <h1 class="page-header alert alert-warning ">حذف کاربر</h1>
    </div>
    <!-- /.col-lg-12 -->
</div>
<div class="container">
    <div class="row">
        <div class="col-md-11 col-sm-12">
            <form method="post">
                <input type="hidden" name="contactId" value="@ViewData["contactId"].ToString()" />
                <ul class="list-group">
                    <li class="list-group-item"> نام ارسال کننده:@Model.ContactUs.FullName</li>
                    <li class="list-group-item">  ایمیل :@Model.ContactUs.Email</li>
                    <li class="list-group-item">  متن پیام: @Model.ContactUs.Description</li>
                </ul>
                <div class="row">
                    <div class="col-md-8 col-sm-10">
                        <input type="submit" class="btn btn-danger" value="حذف" />
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
