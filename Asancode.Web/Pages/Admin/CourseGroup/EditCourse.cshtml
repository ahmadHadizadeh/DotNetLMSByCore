@page "{id}"
@model Asancode.Web.Pages.Admin.CourseGroup.EditCourseModel
@{
    ViewData["Title"] = "EditCourse";
}
<div class="row">
    <div class="col-lg-12">
        <h1 class="page-header alert alert-warning "> ویرایش زیر گروه </h1>
    </div>
    <!-- /.col-lg-12 -->
</div>
<div class="container">
    <div class="row">
        <form method="post">
            <div class="col-md-6 col-sm-5 form-group">
                <input type="hidden" asp-for="CourseGroup.ParentId" />
                <input type="hidden" asp-for="CourseGroup.GroupId" />
                <div class="panel panel-info">
                    <div class="panel-heading">
                        ویرایش زیر گروه ها
                    </div>
                    <div class="panel-body">
                        <input class="form-control" type="text" asp-for="CourseGroup.GroupTitle" placeholder=" ویرایش زیر گروه ها" />
                    </div>
                </div>
            </div>
            <div class="row ">
                <div class="col-md-6 col-md-offset-2">
                    <input type="submit" value="ثبت اطلا عات" class="btn btn-success " />
                </div>
            </div>
        </form>
    </div>
</div>
