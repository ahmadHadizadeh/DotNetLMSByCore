@page
@model Asancode.Web.Pages.Admin.Banner.IndexModel
@{
    ViewData["Title"] = "اطلاعیه های سایت";
}

<div class="container "style="margin-top: 26px;">
    <div class="row">
        <div class="panel panel-info mt-5">
            <div class="panel-heading text-center">
                اطلاعیه های سایت
            </div>

            <div class="panel-body">
                <div class="table table-responsive">
                    <div class="form-inline" role="grid">
                        <div class="row">
                            
                        </div>
                        <div id="dataTables-example_wrapper" class="dataTables_wrapper form-inline" role="grid">
                            <div class="row">
                                <div class="col-md-10">
                                    <a href="/admin/Banner/CreateBanner" class="btn btn-outline btn-success"> ایجاداطلاعیه جدید</a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <table class="table table-bordered table-striped table-hover ">
                        <thead>
                            <tr>
                                <th class="text-center ">تصویر دوره </th>
                               
                                <th class="text-center ">عمیلات</th>
                            </tr>
                        </thead>
                        <tbody>

                        @foreach (var item in Model.BannerInformations)
                        {
                            <tr class="justify-content-center">
                                <td class="text-center text-muted"><img class="text-center"  style="width: 800px; height: 200px;" src="/Banner/MainImage/@item.BannerImageName" /></td>
                                <td>
                                    <a class="btn btn-group-sm btn-sm btn-danger" href="/Admin/Banner/DeleteBanner/@item.BannerId">حذف دوره</a>
                                </td>
                            </tr>
                        }
                            
                        </tbody>
                    </table>
                   
                </div>
            </div>
        </div>
    </div>

</div>

