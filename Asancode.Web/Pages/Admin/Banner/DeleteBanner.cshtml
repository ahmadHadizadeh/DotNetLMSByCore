@page "{id}"
@model Asancode.Web.Pages.Admin.Banner.DeleteBannerModel
@{
    ViewData["Title"] = "حذف بنر";
}
<div class="row">
    <div class="col-lg-12">
        <h1 class="page-header alert alert-warning">@ViewData["Title"]</h1>
    </div>
</div>
<div class="container">
    <div class="row">
        <div class="col-md-11 col-sm-12">
            <form method="post">
                <input type="hidden" name="BannerId" value="@ViewData["BannerId"].ToString()" />
                <ul class="list-group">
                    <li class="list-group-item">نام عکس:@Model.GetBannerForDelete.ImageName</li>
                </ul>
                <div class="row">
                    <div class="col-md-8 col-sm-10">
                        <input type="submit" class="btn btn-danger" value="حذف" />
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
