@model Tuple<int, int>
<hr />
    @if (User.Identity.IsAuthenticated && ViewBag.NotAccess == null)
    {
<div class="row justify-content-center ">
    <div class="col col-lg-12 col-md-8 col-sm-6">
        <div class="alert alert-dark mb-0 text-center" role="alert">آیا این آموزش خوب بود؟ لطفا با ثبت نظر خود به ما  در بهبود کیفیت آموزش های آسان کد کمک کنید.</div>
        <p class="text-center mt-4">

            <button class="alert alert-success alert-pills mb-0" role="alert" onclick="vote(true)">
                <span class="badge rounded-pill bg-white text-info me-1 text-center"> @Model.Item1 </span>
                <span class="content"><img src="/UserPanel/like.png" style="width: 30px;" /></span>
            </button>
            <button class="alert alert-danger alert-pills mb-0" role="alert" onclick="vote(false)">
                <span class="badge rounded-pill bg-white text-info me-1 text-center"> @Model.Item2 </span>
                <span class="content "><img src="/UserPanel/dislike.png" style="width: 30px;" /></span>
            </button>

        </p>
    </div>
</div>
    }


