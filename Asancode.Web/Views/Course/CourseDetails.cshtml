@section Scripts{
    <script src="/js/jquery.unobtrusive-ajax.min.js"></script>
    <script>
        $(function() {
            $("#listComment").load("/Course/ShowComment/" + @Model.CourseId);
        });
        function pageComment(pageid) {
            $("#listComment").load("/Course/ShowComment/" + @Model.CourseId +"?pageId=" + pageid);
        }
        function Success() {
            $("#comments_Comment").val(" ");
        };
        $(function() {
            $("#vot").load("/Course/CourseVote/@Model.CourseId");
        });
        function vote(vote) {
            $("#vot").fadeOut('slow');
            $("#vot").load("/Course/AddVote/@(Model.CourseId)?vote=" + vote);
            $("#vot").fadeIn('slow');
        }
        function copyToClipboard(element) {
            var $temp = $("<input>");
            $("body").append($temp);
            $temp.val($(element).text()).select();
            document.execCommand("copy");
            $temp.remove();
            var textpalert = document.getElementById("short-link-message");
            textpalert.innerHTML = "کپی شد!";
        }
         $(document).ready(function(){
           $("i.uil-copy").click(function(){
           $("#short-link-message").fadeOut(3000);
                                });
                             });
    </script>
