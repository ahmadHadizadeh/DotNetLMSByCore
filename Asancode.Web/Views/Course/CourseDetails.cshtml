                          <a id="matn" title="لینک کوتاه"  href="@(link)">@("https://asancode.com/c/"+Model.ShortKey)
                                    
                          </a>
                          <a tooltype="link"  title="کپی کن" href="javascript:void(0)">
                              <i class="uil-copy text-danger bg-white p-1"  onclick="copyToClipboard('#matn')"> </i>
                          </a>
                      </nav>
                  </div><br /><br />
