@using System.IO
@using Core.Convertors
@using Core.DTO
@using Core.Services.Interfaces
@using DataLayer.Course
@using DataLayer.Entities.Order
@using DataLayer.Entities.User
@model DataLayer.Entities.Course.Course
@inject IOrderService _orderService;



@{
    ViewData["Title"] = Model.CourseTitle;
    bool isUserBuyCourse = false;
    bool isUserBuyPlan = false;
    System.Diagnostics.Debug.Assert(User.Identity != null, "User.Identity != null");
    if (User.Identity.IsAuthenticated)
    {
        isUserBuyCourse = _orderService.IsBuyCourse(User.Identity.Name, Model.CourseId);
        // isUserBuyPlan = _orderService.IsBuyPlan(User.Identity.Name);
    }
    int row = 1;
}
@section MetaTag
{
    <meta name=googlebot content=index,follow>
    <meta name=robots content=noodp,noydir>
    <meta name=description content="شرح صفحه">
    <meta property=og:site_name value="خودآموزآسان کد">
    <meta property=og:title content="@Model.CourseTitle">
    <meta property=og:url content="https://Asancode.com/CourseDetails/@Model.CourseTitle" />
    <meta property=og:image content="/Course/MainImage/@Model.CourseImageName">
    <meta property=og:image:url content="/Course/MainImage/@Model.CourseImageName" />
    <meta property=og:image:width content="700">
    <meta property=og:image:type content="image/jpg">
    <meta property=og:description content="آموزش برنامه نویسی آنلاین">
    <meta property=og:price:currency content="IRR">
    <meta property=og:locale content="ir_FA">
    <link rel="canonical" href="https://Asancode.com/CourseDetails/@Model.CourseId/@Model.CourseTitle.Trim().Replace(" ", "-")" />

}
<link rel="stylesheet" href="/css/asancode.css" type="text/css" />
<section class="bg-half bg-light d-table w-100">
    <div class="container ">
        <div class="row justify-content-center">
            <div class="col-lg-12 text-center">
                <div class="page-next-level">
                    <h3>@Model.CourseTitle </h3>
                    <ul class="list-unstyled mt-4">
                        <li class="list-inline-item h6 user text-muted me-2"><i class="mdi mdi-account"></i>@Model.User.UserName </li>
                        <li class="list-inline-item h6 date text-muted"><i class="mdi mdi-calendar-check"></i>@Model.CreateDate.ToShamci() </li>
                    </ul>
                    <div class="page-next">
                        <nav aria-label="breadcrumb" class="d-inline-block">
                            <ul class="breadcrumb bg-white rounded shadow mb-0">
                                <li class="breadcrumb-item"><a href="/">آسان کد </a></li>
                                <li class="breadcrumb-item"><a href="/Course">دوره های آموزشی</a></li>
                                <li class="breadcrumb-item active" aria-current="page"><a href="/CourseDetails/@Model.CourseId/@Model.CourseTitle">@Model.CourseTitle</a></li>
                            </ul>
                        </nav>
                    </div>
                </div>
            </div><!--end col-->
        </div><!--end row-->
    </div> <!--end container-->
</section>
<div class="position-relative">
    <div class="shape overflow-hidden text-white">
        <svg viewBox="0 0 2880 48" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M0 48H1437.5H2880V0H2160C1442.5 52 720 0 720 0H0V48Z" fill="currentColor"></path>
        </svg>
    </div>
</div>

<section class="section">
    <div class="container All_Font-course">
        <div class="row">
        <!-- BLog Start -->
            <div class="col-lg-8 col-md-6 col-xs-12">
                <div class="card blog blog-detail border-0 shadow rounded">
                    <img class="img-fluid rounded-top" src="/Course/MainImage/@Model.CourseImageName" alt="@Model.CourseTitle">
                    <div class="card-body content">
                        <h6>
                            <i class="mdi mdi-tag text-primary me-1"></i>
                            <a href="/CourseDetails/@Model.CourseId/@Model.CourseTitle" class="text-info">@Model.CourseTitle</a>
                        </h6>
                        <p class="text-muted mt-3"id="descript">@Html.Raw(Model.CourseDescription)</p>
                        <!-- File Demo-->
                        @if (!string.IsNullOrEmpty(Model.DemoFileName))
{
                            <div class="card border-0 shadow rounded ms-lg-4 overflow-hidden">
                                <div class="d-flex p-2 bg-light justify-content-between align-items-center">
                                    <div>
                                        <a href="javascript:void(0)" class="text-danger"><i class="mdi mdi-circle"></i></a>
                                        <a href="javascript:void(0)" class="text-warning"><i class="mdi mdi-circle"></i></a>
                                        <a href="javascript:void(0)" class="text-success"><i class="mdi mdi-circle"></i></a>
                                    </div>
                                    <small class="fw-bold"><i class="mdi mdi-circle-medium text-success"></i> ویدیو</small>
                                </div>
                                <div class="bg-light px-2 position-relative">
                                    <video controls poster="/Course/MainImage/@Model.CourseImageName" class="w-100 rounded">
                                        <source src="/Course/Demo/@Model.DemoFileName" />
                                    </video>

                                    <div class="position-absolute top-0 start-0">
                                        <div class="mt-2 ms-3">
                                            <span class="badge bg-danger">نمایش دموی دوره </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                        <!--End File Demo-->
                        <!--Start Show Online Episode-->
                        @if (ViewBag.Episode != null)
                        {
                            CourseEpisode episode = ViewBag.Episode as CourseEpisode;

                            <div class="card border-0 shadow rounded ms-lg-4 overflow-hidden">
                                <div class="d-flex p-2 bg-light justify-content-between align-items-center">
                                    <div>
                                        <a href="javascript:void(0)" class="text-danger"><i class="mdi mdi-circle"></i></a>
                                        <a href="javascript:void(0)" class="text-warning"><i class="mdi mdi-circle"></i></a>
                                        <a href="javascript:void(0)" class="text-success"><i class="mdi mdi-circle"></i></a>
                                        <small class="fw-bold text-center ">
                                            @if (episode != null)
                                            {
                                                @episode.EpisodeTitle
                                            }
                                        </small>

                                    </div>
                                </div>
                                <div class="bg-light px-2 position-relative">

                                    <video controls poster="/Course/MainImage/@Model.CourseImageName" class="w-100 rounded" id="vid">
                                        <source src="@ViewBag.filePath" />
                                    </video>

                                    <div class="position-absolute top-0 start-0">
                                        <div class="mt-2 ms-3">
                                            <span class="badge bg-danger">نمایش آنلاین </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                        <!--End Show Online Episode-->
                        @* <a class="view-Live-courseasancode" href="https://dl.asancode.com/downloadfile/1402/python/@Item.EpisodeFileName">@Item.EpisodeTitle</a> *@

                        <h3 class="mt-2"> سرفصل های این دوره : </h3>
                        <div class="col  pt-1 active" id="accordions">
                            <div class="component-wrapper rounded shadow">
                                <div class="p-2">
                                    <div class="accordion mt-4 pt-2" id="buyingquestion">
                                        <div class="accordion-item rounded mt-2">
                                            <h2 id="headingOne" class="accordion-header" >
                                                <button class="accordion-button text-right  border-0 bg-light collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="False" aria-controls="collapseOne">
                                                    <h6 class="title"> لیست قسمت های این آموزش</h6>
                                                </button>
                                            </h2>
                                            @foreach (var Item in Model.CourseEpisodes)
                                            {
                                                <div id="collapseOne" class="accordion-collapse border-0 show collapse " aria-labelledby="headingOne" data-bs-parent="#buyingquestion">
                                                    <div class="accordion-body text-muted bg-white">
                                                        <div class="video-item-Course">
                                                            <ul class="view-Live-courseasancode">
                                                                <li class="view-Live-courseasancode">
                                                                    @if (User.Identity.IsAuthenticated == false)
                                                                    {
                                                                       @if (Item.IsFree)
                                                                       {
                                                                           <span class="conterNum-Course-Course"> @row </span>
                                                                           <a class="view-Live-courseasancode" href="/login">@Item.EpisodeTitle</a>
                                                                           <span class="course-time-state" >رایگان </span>
                                                                           row+=1;
                                                                       }
                                                                       else
                                                                       {
                                                                           <span class="conterNum-Course-Course"> @row </span>
                                                                            <a class="view-Live-courseasancode" href="/login">@Item.EpisodeTitle</a>
                                                                           <span class="course-time-state" >نقدی </span>
                                                                           row+=1;
                                                                       }
                                                                    }
                                                                  
                                                                    @if (User.Identity.IsAuthenticated)
                                                                    {

                                                                        @if (Item.IsFree || isUserBuyCourse)
                                                                        {
                                                                            <span class="conterNum-Course-Course"> @row </span>
                                                                            <a class="view-Live-courseasancode" href="https://dl.asancode.com/downloadfile/1402/python/@Item.EpisodeFileName">@Item.EpisodeTitle</a>
                                                                            row += 1;
                                                                        }
                                                                        else
                                                                        {
                                                                            <span class="conterNum-Course-Course"> @row </span>
                                                                            <a class="view-Live-courseasancode" href="/Course/BuyCourse/@Model.CourseId"> @Item.EpisodeTitle</a>
                                                                            row += 1;
                                                                        }
                                                                        @if (Item.IsFree)
                                                                        {
                                                                            <span class="course-time-state" href="JavasScript.void(0)">رایگان </span>
                                                                        }
                                                                        else
                                                                        {
                                                                            <p class="d-inline course-time-state"> نقدی</p>
                                                                        }

                                                                    // if (Item.IsFree || isUserBuyCourse)
                                                                    // {
                                                                    @* <a class="view-Live-courseasancode" href="/CourseDetails/@Model.CourseId/@Model.CourseTitle/?episode=@Item.EpisodeId"> *@
                                                                    @* <a class="view-Live-courseasancode" href="https://dl.asancode.com/downloadfile/1402/python/@Item.EpisodeFileName"> *@
                                                                    @* <i class="float-end  mdi mdi-play-circle-outline h4 me-2 text-info"></i> *@
                                                                    @* <script>var video = document.getElementById("vid");</script> *@
                                                                    @* </a> *@
                                                                    //}
                                                                    }
                                                                    <span class="course-time-left-course d-inline me-1">@Item.EpisodeTime</span>
                                                                </li>
                                                            </ul>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                    <div id="vot">

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card shadow rounded border-0 mt-4">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <form asp-controller="Course" asp-action="CreateComment" class="p-2"
                                  data-ajax="true"
                                  data-ajax-method="post"
                                  data-ajax-mode="replace"
                                  data-ajax-update="#listComment"
                                  data-ajax-success="Success">
                                <input type="hidden" name="comments.CourseId" value="@Model.CourseId" />
                                @if (isUserBuyCourse)
                                {
                                    <div class="mt-4 pt-2">
                                        <p class="text-muted">
                                            لطفا نظر خود را در مورد این دوره برای ما بنویسید:
                                            <div class="form-group">
                                                <textarea class="form-control" id="comments_Comment" name="comments.Comment" placeholder="متن نظر"></textarea>
                                            </div>
                                    </div>
                                    <button type="submit"  class="btn btn-info mb-4 mt-2 pt-2"> ثبت دیدگاه </button>
                                }
                            </form>
                            <div class="card shadow rounded border-0 mt-3 text-muted fst-italic rounded " id="listComment"  style="text-align: right">
                            </div>
                        }
                    </div>
                </div>
                <!-- Comment Course-->
            </div>
