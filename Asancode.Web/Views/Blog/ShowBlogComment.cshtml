@using Core.Convertors
@model Tuple<List<DataLayer.Entities.Bloger.CommentBlog>, int>
@{ Layout = null; }
<div class="accordion mt-4 pt-2" id="buyingquestion">
    <div class="accordion-item rounded">
        <h2 class="accordion-header text-center" id="headingOne">
            <button class="accordion-button text-center  border-0 bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                <i class="uil uil-mouse text-muted h5"></i>   لیست نظرات کاربران
            </button>
        </h2>
        <div class="d-flex justify-content-between p-4 bg-light mt-4">
            <h6 class="mb-0"> <i class="uil uil-comment-add text-muted h5"></i> نظرات </h6>
            <h6 class="mb-0">تاریخ </h6>
        </div>

        @foreach (var item in Model.Item1)
        {

            <div id="collapseOne" class="accordion-collapse border-0 collapse show" aria-labelledby="headingOne" data-bs-parent="#buyingquestion" style="">
                <div class="accordion-body text-muted bg-white">
            <div class="p-4">
                <div class="d-flex justify-content-between">
                    <div class="d-flex align-items-center">
                        <a class="pe-3" href="#">
                            <img src="/UserPanel/@item.User.UserImage" class="img-fluid avatar avatar-md-sm rounded-circle shadow" alt="تصویر کاربرنظر دهنده">
                        </a>
                        <div class="flex-1 commentor-detail">
                            <h6 class="mb-0">
                                <a href="javascript:void(0)" class="media-heading text-dark">@item.User.UserName </a>
                            </h6>

                        </div>
                    </div>
                    <small class="text-muted">@item.CreateDate.ToShamci()</small>
                </div>
                <div class="mt-3">
                    <i class="uil uil-comment text-muted h5"></i>
                    <p class="text-muted fst-italic p-3 bg-light rounded"> @Html.Raw(item.Comment) </p>
                </div>
            </div>
            </div>
            </div>
        }

        <div class="col-12 mt-4 pt-2">
            <ul class="pagination justify-content-center mb-3">
                <li class="page-item"><a class="page-link" href="javascript:void(0)" aria-label="Previous">قبلی </a></li>
                @for (int i = 1; i <= Model.Item2; i++)
                {

                    <li class="page-item"><a href="javascript:void(0)" class="page-link" onclick="pageComment(@i)">@i</a></li>

                }
                <li class="page-item"><a class="page-link" href="javascript:void(0)" aria-label="Next">بعدی </a></li>
            </ul>
        </div>
    </div>
</div>

