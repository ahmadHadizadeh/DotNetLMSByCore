@using Core.Convertors
@using DataLayer.Entities.User
@model DataLayer.Entities.Bloger.Blog
@{
    ViewData["Title"] = "مقاله ها";

}
<section class="bg-half bg-light d-table w-100">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-12 text-center">
                <div class="page-next-level">
                    <h2> @Model.Title </h2>
                    <ul class="list-unstyled mt-4">
                        <li class="list-inline-item h6 user text-muted me-2"><i class="mdi mdi-account"></i>@Model.Writer </li>
                        <li class="list-inline-item h6 date text-muted"><i class="mdi mdi-calendar-check"></i>@Model.Date.ToShamci() </li>
                    </ul>
                    <div class="page-next">
                        <nav aria-label="breadcrumb" class="d-inline-block">
                            <ul class="breadcrumb bg-white rounded shadow mb-0">
                                <li class="breadcrumb-item"><a href="index.html">آسان کد </a></li>
                                <li class="breadcrumb-item"><a href="/Blog/">وبلاگ </a></li>
                                <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
                            </ul>
                        </nav>
                    </div>
                </div>
            </div><!--end col-->
        </div><!--end row-->
    </div> <!--end container-->
</section>

<div class="position-relative">
    <div class="shape overflow-hidden text-white">
        <svg viewBox="0 0 2880 48" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M0 48H1437.5H2880V0H2160C1442.5 52 720 0 720 0H0V48Z" fill="currentColor"></path>
        </svg>
    </div>
</div>

<section class="section">
    <div class="container">
        <div class="row">
            <!-- BLog Start -->
            <div class="col-lg-8 col-md-6">
                <input type="hidden" asp-for="BlogId" />
                <div class="card blog blog-detail border-0 shadow rounded">
                    <img src="/Blog/MainImage/@Model.BlogImageName" class="img-fluid rounded-top" alt="@Model.Title">
                    <div class="card-body content">
                        <h6><i class="mdi mdi-tag text-primary me-1"></i>
                            <a class="text-info" href="https://asancode.com/ShowBlog/@Model.BlogId">@Model.Title</a></h6>
                        <p class="text-muted mt-3">@Html.Raw(Model.TextBlog)</p>
                    </div>
                </div>

                <div class="card shadow rounded border-0 mt-4">
                    <div class="card-body">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <form asp-controller="Blog" asp-action="CreateComment"
                                  data-ajax="true"
                                  data-ajax-method="post"
                                  data-ajax-mode="replace"
                                  data-ajax-update="#listComment"
                                  data-ajax-success="Success">
                                <input type="hidden" name="comments.BlogId" value="@Model.BlogId" />
                                <h5 class="card-title mb-0">ارسال نظر :</h5>
                                <div class="col-md-12">
                                    <div class="mb-3">
                                        <div class="form-icon position-relative">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-message-circle fea icon-sm icons"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
                                            <textarea id="comments_Comment" name="comments.Comment" placeholder="متن نظر" rows="5" class="form-control ps-5"></textarea>
                                        </div>
                                    </div>
                                </div><!--end col-->
                                <div class="col-md-12">
                                    <div class="send d-grid">
                                        <button type="submit" class="btn btn-primary">ارسال پیام</button>
                                    </div>
                                </div><!--end col-->
                                <!--end row-->
                            </form>
                        }
                        else
                        {
                            <div class="alert alert-dark text-center">
                                جهت ثبت نظر باید در سایت <a class="d-inline text-info" href="/Register"> عضو شوید </a> و یا <a class="text-info " href="/Login"> وارد سایت </a> شده باشید .
                            </div>
                        }
                        <div class="comment-list" id="listComment" style="text-align: right">
                       </div>
                    </div>
                </div>
                <!--end row-->
                <!--</div>
                </div>-->
            </div>
            <!-- BLog End -->
            <!-- START SIDEBAR -->
            <div class="col-lg-4 col-md-6 col-12  mt-sm-0 pt-2 pt-sm-0">
                <div class="box-Social-Linnk box-Social-shadow Social-Linnk p-relative">
                    <div class="text-right font-weight-bold">این مقاله را به اشتراک بگذارید:</div>
                    <ul dir="ltr" class="box-Social-nopad">
                        <li>
                            <a class="blog-sociallink" href="https://t.me/share/url?url=https://Asancode.com/ShowBlog/@Model.BlogId" target="_blank">
                                <img class="blog-sociallink" src="/UserPanel/telegra.png" alt="به اشتراک گذاری در تلگرام" width="29">
                            </a>
                        </li>
                        <li>
                            <a href="https://www.linkedin.com/sharing/share-offsite/?url=https://Asancode.com/ShowBlog/@Model.BlogId" target="_blank">
                                <img class="blog-sociallink" src="/UserPanel/linkedin.png" alt="به اشتراک گذاری در لینکدین" width="29">
                            </a>
                        </li>
                        <li>
                            <a href="https://www.instagram.com/accounts/login/" target="_blank">
                                <img class="blog-sociallink" src="/UserPanel/instagram2.png" alt="به اشتراک گذاری در اینستا گرام" width="29">
                            </a>
                        </li>
                        <li>
                            <a target="_blank" href="https://www.facebook.com/sharer/sharer.php?u=https://Asancode.com/ShowBlog/@Model.BlogId">
                                <img class="blog-sociallink" src="/UserPanel/facebook.svg" alt="به اشتراک گذاری در فیس بوک" width="29">
                            </a>
                        </li>
                    </ul>
                    <!-- shortlink -->
                    <div class="mt-10 text-right">
                        لینک کوتاه:
                    </div>
                    <div dir="ltr" class="p-relative asancode-shortlink mt-10">
                        <div class="autocopy">
                            <p id="matn">
                                <a href="https://asancode.com/b/2235">https://asancode.com/B/2235</a>
                            </p>
                            <button class="asancode-shortlink" onclick="copyToClipboard('#matn')">کپی لینک</button>
                        </div>
                        <p id="short-link-message" dir="rtl"></p>
                    </div>
                    <!-- shortlink -->
                </div>
                <div class="card border-0 sidebar sticky-bar rounded shadow">
                    <div class="card-body">
                        <!-- پست های اخیر -->
                        <div class="widget mb-4 pb-2">
                            <h5 class="widget-title">مقالات توصیه شده</h5>
                            @foreach (var item in ViewBag.slidBlog)
                            {
                                <div class="mt-4">
                                    <div class="clearfix post-recent">
                                        <div class="post-recent-thumb float-start">
                                            <a href="/ShowBlog/@item.BlogId/@item.BlogTitles.Trim().Replace(" ", "-")">
                                                 <img alt="img" src="/Blog/Thumnail/@item.BlogImage" class="img-fluid rounded">
                                            </a>
                                        </div>
                                        <div class="post-recent-content float-start">
                                            <a target="_blank" href="/ShowBlog/@item.BlogId/@item.BlogTitles.Trim().Replace(" ", "-")">@item.BlogTitles </a>
                                            <span class="text-muted mt-2">@ViewBag.dt</span>
                                        </div>
                                    </div>
                                </div>

                            }
                            <div class="Article-leftshowBlog-ShowMore">
                                <a style="overflow-wrap: break-word;" href="https://www.asancode.com/blog">مشاهده بیشتر  ←</a>
                            </div>
                        </div>

                        <!-- پست های اخیر -->
                        <!-- TAG CLOUDS -->
                        @if (Model.Tags != null)
                        {
                            <div class="widget mb-4 pb-2">
                                <h5 class="widget-title">برچسب های ابری</h5>
                                <div class="tagcloud mt-4">
                                    @foreach (string tag in Model.Tags.Split("-", StringSplitOptions.RemoveEmptyEntries))
                                    {
                                        <a href="/Blog?filter=@tag" class="rounded ">@tag</a>
                                    }
                                </div>
                            </div>
                        }
                        <!-- TAG CLOUDS -->
                        <!-- SOCIAL -->
                        <div class="widget">
                            <h5 class="widget-title">دنبال کردن ما</h5>
                            <ul class="list-unstyled social-icon mb-0 mt-4">
                                <li class="list-inline-item"><a href="http://instagram.com/Asan_Code" class="rounded"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-instagram fea icon-sm fea-social"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg></a></li>
                                <li class="list-inline-item"><a href="https://www.facebook.com/" class="rounded"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-facebook fea icon-sm fea-social"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg></a></li>
                                <li class="list-inline-item"><a href="https://www.linkedin.com/in/ahmad-hadizadeh-374683132/" class="rounded" title="linkedin"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-linkedin fea icon-sm fea-social"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg></a></li>
                                <li class="list-inline-item"><a href="mailto:myAsancode@gmail.com" class="rounded"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-mail fea icon-sm fea-social"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon></svg></a></li>
                            </ul><!--end icon-->
                        </div>
                        <!-- SOCIAL -->
                    </div>
                </div>
            </div><!--end col-->
            <!-- END SIDEBAR -->
        </div><!--end row-->
    </div><!--end container-->
</section>




@section Scripts{
    <script src="/js/jquery.unobtrusive-ajax.min.js"></script>
    <script>
        $(function() {
            $("#listComment").load("/Blog/ShowBlogComment/" + @Model.BlogId);
        });
        function pageComment(pageid) {
            $("#listComment").load("/Blog/ShowBlogComment/" + @Model.BlogId +"?pageId=" + pageid);
        }
        function Success() {
            $("#comments_Comment").val(" ");
        };
        
        function copyToClipboard(element) { 
            var $temp = $("<input>");
            $("body").append($temp);
            $temp.val($(element).text()).select();
            document.execCommand("copy");
            $temp.remove();
            var textpalert = document.getElementById("short-link-message");
            textpalert.innerHTML = "کپی انجام شد!";
        }
    </script>
}
