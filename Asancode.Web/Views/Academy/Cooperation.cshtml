@{
    ViewData["Title"] = "همکاری با ما";
}
<section class="bg-half bg-light d-table w-100">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-12 text-center">
                <div class="page-next-level">
                    <h3> </h3>
                    <ul class="list-unstyled ">
                        <li class="list-inline-item h6 user text-muted me-2">
                            <i class="uil uil-constructor h3 d-block rounded  mb-0  text-info"></i>
                            <i class="mdi mdi-account">همکاری با آسان کد</i>
                        </li>
                    </ul>
                    <div class="page-next">
                        <nav aria-label="breadcrumb" class="d-inline-block">
                            <ul class="breadcrumb bg-white rounded shadow mb-0">
                                <li class="breadcrumb-item"><a href="/">آسان کد </a></li>
                                <li class="breadcrumb-item active" aria-current="page"><a href="/Terms">همکاری با آسان کد  </a></li>
                            </ul>
                        </nav>
                    </div>
                </div>
            </div><!--end col-->
        </div><!--end row-->
    </div> <!--end container-->
</section>

<section class="bg-half-170 border-bottom agency-wrapper d-table w-100" id="home">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-7 col-md-7 order-1 order-md-2">
                <div class="title-heading mt-4 ms-lg-5">
                    <h1 class="heading mb-3">دانشگاه آنلاین آموزشی  <span class="text-primary">آسان کد  </span>  ساعت ها آموزش در حوزه های مختلف   </h1>
                    <p class="para-desc text-muted"> شما اساتید محترم و متخصصان عزیز در حوزه های مختلف میتوانید مهارت و تخصص خود را با دانشجویان  سراسر کشور و دنیا به اشتراک بگذارید .برای همکاری در قسمتهای مختلف میتوانید به بخش های زیر مراجعه بفرمایید.</p>
                    <div class="mt-4 pt-2">
                        <a href="javascript:void(0)" class="btn btn-primary m-1">ادامه مطلب  <i class="uil uil-angle-left-b"></i></a>
                        @*<a href="#" data-type="youtube" data-id="yba7hPeTSjk" class="btn btn-icon btn-pills btn-primary m-1 lightbox"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-video icons"><polygon points="23 7 16 12 23 17 23 7"></polygon><rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect></svg></a><span class="fw-bold text-uppercase small align-middle ms-1">اکنون تماشا کنید </span>*@
                    </div>
                </div>
            </div><!--end col-->

            <div class="col-lg-5 col-md-5 order-2 order-md-1 mt-4 pt-2 mt-sm-0 pt-sm-0">
                <img src="/image/coorporation.png" class="img-fluid" alt="">
            </div>
        </div><!--end row-->
    </div><!--end container-->
</section>
<div class="position-relative">
    <div class="shape overflow-hidden text-white">
        <svg viewBox="0 0 2880 48" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M0 48H1437.5H2880V0H2160C1442.5 52 720 0 720 0H0V48Z" fill="currentColor"></path>
        </svg>
    </div>
</div>

<div class="container">
    <div class="row">
        <div class="col-lg-4 col-md-6 col-12 mt-4 pt-2 mb-4">
            <div class="card text-center features fea-primary rounded p-4 bg-light position-relative overflow-hidden border-0">

                <span class="iconify  h1" style="color: #00e64d; " data-icon="medical-icon:i-health-education" data-flip="horizontal"></span>

                <div class="card-body p-0 content">
                    <h5>همکاری در بخش آموزش و تدریس</h5>
                    <p class="text-dark  mb-0"> شما مدرسان گرامی و محترم می توانید علم و تخصص خود را در زمینه ها و حوزه های مختلف آموزشی،علمی، به صورت آنلاین با همه دانشجویان به اشتراک بگذارید و کسب درآمد کنید.</p>
                </div>
                <a class="btn btn-outline-info" href="/Education">روند تدریس</a>

            </div>
        </div>
        <div class="col-lg-4 col-md-6 col-12 mt-4 pt-2 mb-4">
            <div class="card features fea-primary rounded p-4 bg-light position-relative overflow-hidden border-0">
                <span class="h1 icon2 text-warning">
                    <span class="iconify" data-icon="logos:google-developers" data-flip="horizontal"></span>
                </span>
                <div class="card-body p-0 content">
                    <h5>همکاری در بخش مقاله نویسی و انتشار دانش</h5>
                    <p class="text-dark  mb-0">علاقه مندان در زمینه مقاله نویسی و انتشار دانشهای خود در سایر زمینه ها میتوانند با ما همکاری کنند.</p>
                </div>
                <a class="btn btn-outline-info" href="/Bloger">روند مقاله نویسی</a>

            </div>
        </div>
        <div class="col-lg-4 col-md-6 col-12 mt-4 pt-2 mb-4">
            <div class="card features fea-primary rounded p-4 bg-light position-relative overflow-hidden border-0">
                <span class="h1 icon2 text-warning">
                    <span class="iconify" data-icon="ls:bag" style="color: #ff5c33; " data-flip="horizontal"></span>
                </span>
                <div class="card-body p-0 content">
                    <h5>همکاری در بخش های اداری آموزشگاه</h5>
                    <p class="text-dark  mb-0"> با توجه به رشد دپارتمان های مختلف آموزشگاه آسان کد  در بخش های مختلف این آموزشگاه بر حسب تخصص شما برای همکاری دربخش های مختلف اداری دعوت به عمل می آید.</p>
                </div>
                <a class="btn btn-outline-info" href="/Office">فرایند همکاری</a>

            </div>
        </div>
    </div>
</div>
@section Scripts
{
    <script src="https://code.iconify.design/2/2.0.3/iconify.min.js"></script>
}
