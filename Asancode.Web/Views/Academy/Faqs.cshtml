                            <button class="accordion-button border-0 bg-light collapsed title " type="button" data-bs-toggle="collapse" data-bs-target="#collapseeight" aria-expanded="false" aria-controls="collapseeight">
                                <h6 class="title">  بعد از یادگیری زبان بک اند چیکارکنیم؟</h6>
                            </button>
                        </h2>
                        <div id="collapseeight" class="accordion-collapse border-0 collapse" aria-labelledby="headingeight" data-bs-parent="#generalquestion">
                            <div class="accordion-body text-muted bg-white">
