@{
    ViewData["Title"] = "Bloger";
}
<section class="bg-half-170 agency-wrapper d-table w-100" id="home">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-5 col-md-5 order-2 order-md-1 mt-4 pt-2 mt-sm-0 pt-sm-0">
                <img src="/image/blogger.png" class="img-fluid" alt="">
            </div>
            <div class="col-lg-7 col-md-7 order-1 order-md-2">
                <div class="title-heading mt-4 ms-lg-5">
                    <h1 class="heading mb-3">جذب نویسنده و بلاگر در  <span class="text-primary">آسان کد </span>  </h1>
                    <p class="para-desc text-muted"> علاقه مندان به نویسندگی در  حوزه فناوری و اطلاعات ،وب، اپلیکیشن ، و خصوصا برنامه نویسی می توانند جهت همکاری با ما در بخش تولید محتوای وب سایت همکاری کنند </p>
                </div>
            </div><!--end col-->
        </div><!--end row-->
    </div><!--end container-->
</section>
<div class="container">
    <div class="row justify-content-center">
        <div class="col-lg-12 text-center">
            <div class="page-next">
                <nav aria-label="breadcrumb" class="d-inline-block">
                    <ul class="breadcrumb bg-white rounded shadow mb-0">
                        <li class="breadcrumb-item"><a href="/">آسان کد </a></li>
                        <li class="breadcrumb-item active"><a href="/Bloger">مقاله نویسی در آسان کد </a></li>
                    </ul>
                </nav>
            </div>
        </div>
        <div class="col-lg-8 col-md-7 col-12">
            <div class="section-title mt-5" id="support">
                <h4 class="p-2 m-1 text-center" style="border: 1px dotted #94d2bd; border-radius: 20px">شرایط عضویت در تیم مقاله نویسی آسان کد؟</h4>
            </div>

            <div class="accordion mt-4 pt-2" id="supportquestion">
                <div class="accordion-item rounded">
                    <h2 class="accordion-header" id="headingthirteen">
                        <button class="accordion-button border-0 bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#collapsethirteen" aria-expanded="true" aria-controls="collapsethirteen">
                            چه شرایطی برای عضویت درتیم بلاگری آسان کد میاز هست؟
                        </button>
                    </h2>
                    <div id="collapsethirteen" class="accordion-collapse border-0 collapse show" aria-labelledby="headingthirteen" data-bs-parent="#supportquestion">
                        <div class="accordion-body text-muted bg-white">
                            برخلاف اکثر وب سایت ها که شرایط سفت وسختی را برای مقاله نویس هادرنظر میگیرند ما بر آنیم تا
                            در یک اقدام نوین و جدید برای این بخش ،شرایط خاصی رادر نظر نگیریم
                            چرا که کاملا اذغان داریم که یک بلاگر و نویسندهاولین شرایطی که بایدداشته باشد تا مقالات پویا و جذابی را تولید کند، علاقه قلبی وی به این حوزه 
                            میباشد .
                            چون معتقدیم که این تخصص به قول هنری ها، یک کار کاملا دلی هست و فرد باید عاشق این کار باشد تا مخاطب های زیادی پیدا کند.
                        
                            </div>
                    </div>
                </div>
                <div class="accordion-item rounded mt-2">
                    <h2 class="accordion-header" id="headingfourteen">
                        <button class="accordion-button border-0 bg-light collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapsefourteen" aria-expanded="false" aria-controls="collapsefourteen">
                            موضو عات مقاله های وب سایت؟
                        </button>
                    </h2>
                    <div id="collapsefourteen" class="accordion-collapse border-0 collapse" aria-labelledby="headingfourteen" data-bs-parent="#supportquestion">
                        <div class="accordion-body text-muted bg-white">
                            <p class="text-muted">
                                خوب با  توجه به این که وبسایت آسان کد یک سایت آموزشی در زمینه های برنامه نویسی و طراحی سایت و فناوری اطلاعات می باشد
                                به طبع آن نیز موضوعات مقالات  در همین زمینه ها تهیه می شود.
                            </p>
                        </div>
                    </div>
                </div>

                <div class="accordion-item rounded mt-2">
                    <h2 class="accordion-header" id="headingfifteen">
                        <button class="accordion-button border-0 bg-light collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapsefifteen" aria-expanded="false" aria-controls="collapsefifteen">
                            آیا مقلات کپی شده را میتوانیم در سایت بارگذاری کنیم؟
                        </button>
                    </h2>
                    <div id="collapsefifteen" class="accordion-collapse border-0 collapse" aria-labelledby="headingfifteen" data-bs-parent="#supportquestion">
                        <div class="accordion-body text-muted bg-white">
                            <p class="text-muted">
                                باتوجه به قوانین پیگیرانه وسفت و سخت حوزه دیجیتال مارکتینگ و قانون کپی رایت ،و احترام کامل به حق مولفین در این صنعت
                                ما نیز به این موضوع کاملا احترام میگذاریم تا حقی از تولید کننده های
                                اصلی این مقالات ضایع نگردد.
                                از آنجایی که بلاگرها در حوزه تخصصی خود، استعداد و هوش نویسندگی خلاق و فعالی را دارا می باشند ، ما نیز به پشتیبانه این تخصص آنها
                                خواستار فعالیت این عزیزان در این حوزه می باشیم.
                            </p>
                        </div>
                    </div>
                </div>

                <div class="accordion-item rounded mt-2">
                    <h2 class="accordion-header" id="headingsixteen">
                        <button class="accordion-button border-0 bg-light collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapsesixteen" aria-expanded="false" aria-controls="collapsesixteen">
                            شرایط خاصی جهت حضور در آموزشگاه برای این کار وجودارد؟
                        </button>
                    </h2>
                    <div id="collapsesixteen" class="accordion-collapse border-0 collapse" aria-labelledby="headingsixteen" data-bs-parent="#supportquestion">
                        <div class="accordion-body text-muted bg-white">
                            <p class="text-muted">
                                در  عصری که همه کارها تنها و تنها با یک کلیک قابل انجام هست
                                دیگر نیازی به حضور فیزیکی افراد در این نهاد نمی باشد
                                شما به راحتی بعد از تایید میتوانید از هرجای که هستید برای ما مقالات جذاب خود را ارسال فرمائید
                                و خبر خوب دیگر نیز اینکه ما  به سن نویسنده هیچ اهمیتی نمی دهیم چرا که نسل امروز ما نسلی
                                بسیار باهوش و خلاق  در همه زمینه ها به خصوص در زمینه تکنولوژی ها هستند
                            </p>
                        </div>
                    </div>
                </div>
                
                <div class="accordion-item rounded mt-2 mb-4">
                    <h2 class="accordion-header" id="headingseventin">
                        <button class="accordion-button border-0 bg-light collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#headingseventin" aria-expanded="false" aria-controls="collapsesixteen">
                            نحوه ارسال درخواست برای مقاله نویسی و بلاگری؟
                        </button>
                    </h2>
                    <div id="headingseventin" class="accordion-collapse border-0 collapse" aria-labelledby="headingseventin" data-bs-parent="#supportquestion">
                        <div class="accordion-body text-muted bg-white">
                            <p class="text-muted">
                                شما دوستان و همکاران محترم ما میتوانید جهت همکاری در این زمینه تخصصی در قسمت
                                <a class="text-info" href="/HelpCenter">پشتیبانی تماس-ارسال تیکت</a>
                                رفته و درخواست خود را برای ما ارسال فرمایید که همکاران ما در اولین فرصت با شما تماس خواهند گرفت
                                 لطفا شماره تماس خود را نیز به همراه در خواست خود برای ما ارسال فرمائید .
                                یا می توانید در بخش های مختلف سوشیال مدیا که در قسمت فوتر یا دیگرقسمت های  مختلف سایت هم هستند به ما پیام بدهید
                                که گروه پشتیبانی ما آن را ترتیب اثر خواهند  داد.
                            </p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>



