@using DataLayer.Entities.User
@model Core.DTO.LoginViewModel
@{ ViewData["Title"] = "ورود به سایت"; }

<section class="bg-half bg-light d-table w-100">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-12 text-center">
                <div class="page-next-level">
                    <h3> </h3>
                    <ul class="list-unstyled mt-4">

                        <li class="list-inline-item h6 date text-muted"><i class="uil uil-signin d-block rounded  mb-0 h3 text-info "></i> </li>
                    </ul>
                    <div class="page-next">
                        <nav aria-label="breadcrumb" class="d-inline-block">
                            <ul class="breadcrumb bg-white rounded shadow mb-0">
                                <li class="breadcrumb-item"><a href="/">آسان کد </a></li>
                                <li class="breadcrumb-item"><a href="/login">ورود به سایت آسان کد</a></li>
                            </ul>
                        </nav>
                    </div>
                </div>
            </div><!--end col-->
        </div><!--end row-->
    </div> <!--end container-->
</section>

<div class="position-relative">
    <div class="shape overflow-hidden text-white">
        <svg viewBox="0 0 2880 48" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M0 48H1437.5H2880V0H2160C1442.5 52 720 0 720 0H0V48Z" fill="currentColor"></path>
        </svg>
    </div>
</div>
<!-- شوع آن -->
<section class="bg-home d-flex align-items-center mt-5">
    <div class="container">
        <div class="row mb-4">
            <div class="col-12 col-lg-6">
                <div class="me-lg-5">
                    <img src="/UserPanel/login.svg" class="img-fluid" alt="عکس لاگین">
                </div>
            </div>
            <div class="col-12 col-sm-12 col-lg-6 ">
                <div class="card login-page bg-white shadow rounded border-0">
                    <div class="card-body">

                        @if (ViewBag.IsSuccess != null)
                        {
                            <div class="alert alert-success text-center">
                                <p>ورود شما با موفقیت انجام شد</p>
                                <script>
                                    var delay = 2000;
                                    setTimeout(function () { window.location = "https://localhost:44345/Userpanel" }, delay);
                                </script>
                            </div>
                        }
                        @if (ViewBag.EditProfile == true)
                        {
                            <div class="alert alert-warning ">
                                <p class=" text-center help-block">
                                    کاربر گرامی : با توجه به ویرایش حسابی که انجام دادید، لطفا دوباره لاگین کنید
                                </p>
                            </div>}

                        <h4 class="card-title text-center">وارد شدن </h4>
                        @if (User.Identity.IsAuthenticated)
                        {
                            <div class="alert alert-success" style="text-align: center">
                                <p class="text-white text-center">شما با موفقیت وارد سایت شدید</p>
                                <script>
                                    var delay = 2000;
                                    setTimeout(function () { window.location = "/" }, delay);
                                </script>
                            </div>
                        }
                        <form class="login-form mt-4" asp-route="LoginPost">
                            <div class="row mb-4">
                                <div class="col-lg-12">
                                    <div class="mb-3">
                                        <label class="form-label">ایمیل شما <span class="text-danger">*</span></label>
                                        <div class="form-icon position-relative">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-user fea icon-sm icons"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                                            <input type="text" class="form-control ps-5  " placeholder="ایمیل" asp-for="Email" aria-describedby="email-address">
                                            <span class="text-danger" asp-validation-for="Email"></span>
                                        </div>
                                    </div>
                                </div><!--end col-->
                                <div class="col-lg-12">
                                    <div class="mb-3">
                                        <label class="form-label">رمز عبور <span class="text-danger">*</span></label>
                                        <div class="form-icon position-relative">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-key fea icon-sm icons"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"></path></svg>
                                            <input type="password" class="form-control ps-5" placeholder="رمز عبور " asp-for="Password" aria-describedby="password">
                                            <span class="text-danger" asp-validation-for="Password"></span>
                                        </div>
                                    </div>
                                </div><!--end col-->
                                <div class="col-lg-12">
                                    <div class="d-flex justify-content-between">
                                        <div class="mb-3">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" id="flexCheckDefault">
                                                <label class="form-check-label" asp-for="RememberMe" for="flexCheckDefault">مرا به خاطر بسپار </label>
                                            </div>
                                        </div>
                                        <p class="forgot-pass mb-0">
                                            <a href="/ForgotPassword" class="text-dark fw-bold">فراموشی رمز عبور؟ </a>
                                        </p>
                                        <p class="forgot-pass mb-0">
                                            <a href="/Register" class="text-dark fw-bold">عضویت در سایت </a>
                                        </p>
                                    </div>
                                </div><!--end col-->
                                <div class="col-md-12">
                                    <div class="mb-3">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" value="" id="flexCheckDefault">
                                            <label class="form-check-label" for="flexCheckDefault"><a href="/Terms" class="text-primary">قوانین سایت </a>آسان کد را تایید می کنم.</label>
                                        </div>
                                    </div>
                                </div>
                                <!--Recaptcha-->
                                @*<div class="row">
                                        <div class="col-lg-12  col-md-10">
                                            <div class="mb-3">
                                                <div class="form-group">
                                                    <div style="direction: ltr;" class="g-recaptcha"  data-sitekey="6Ld5m5YdAAAAAA9r-_rvPhURDNKU2a6b77HQDZUQ"></div>
                                                    <p class="text-danger">@ViewBag.Message</p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>*@
                                <!--Recaptcha-->
                                <div class="col-lg-12 mb-0">
                                    <div class="d-grid">
                                        <button class="btn btn-primary">ورود </button>
                                    </div>
                                </div><!--end col-->
                                <div class="col-lg-12 mt-4 text-center">
                                    <h6>یا با آن وارد شوید</h6>
                                    <div class="row ">
                                        <div class="col-6 mt-3">
                                            <div class="d-grid">
                                                <a href="/provider/Facebook" class="btn btn-light"><i class="mdi mdi-facebook text-primary"></i> فیس بوک </a>
                                            </div>
                                        </div>
                                        <!--end col-->
                                        <div class="col-6 mt-3">
                                            <div class="d-grid">
                                                <a href="/provider/Google" class="btn btn-light">
                                                    <i class="mdi mdi-google text-danger"></i> گوگل
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div><!--end col-->
                                <div class="col-12 text-center pb-2">
                                    <p class="mb-0 mt-3"><small class="text-dark me-2">حسابی ندارید؟ </small> <a href="/Register" class="text-dark fw-bold">ثبت نام کنید </a></p>
                                </div><!--end col-->
                            </div><!--end row-->
                        </form>
                    </div>
                </div><!---->
            </div> <!--end col-->
        </div><!--end row-->
    </div> <!--end container-->
</section><!--end section-->
<!-- پایان آن -->

<style type="text/css">
    .typewrite > .wrap {
        border-right: 0.08em solid transparent
    }
</style>