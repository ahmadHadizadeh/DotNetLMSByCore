@model DataLayer.Entities.User.Users
<!-- شوع آن -->
    <div style="margin-top: 50px;">
        <table style="direction: rtl; text-align: right;  font-family: IRANSansfanum; font-size: 15px; font-weight: 400; max-width: 600px; border: none; margin: 0 auto; border-radius: 6px; overflow: hidden; background-color: #fff; box-shadow: 0 0 3px rgba(60, 72, 88, 0.15);" cellspacing="0" cellpadding="0">
            <thead>
                <tr style="background-color: #00b386; padding: 3px 0; border: none; line-height: 68px; text-align: center; color: #fff; font-size: 24px; letter-spacing: 1px;">
                    <th scope="col" style="font-size: 17px;color: #f8f9fc ">ثبت نام با موفقیت انجام شد</th>
                </tr>
            </thead>

            <tbody>
                <tr>
                    <td style="padding: 48px 24px 0; color: #161c2d; font-size: 18px; font-weight: 600;">
                        سلام  @Model.UserName  عزیز
                    </td>
                </tr>
                <tr>
                    <td style="padding: 17px 24px 15px; color: #8492a6; font-size: 16px;">
                        با تشکر از شما برای ایجاد حساب کاربری و ثبت نام درآکادمی آموزشی آسان کد . لطفا برای ادامه وفعال سازی حساب خود ،  با کلیک بر روی دکمه زیر آدرس ایمیل خود را تأیید نمایید :
                    </td>
                </tr>

                <tr>
                    <td style="padding: 15px 24px;">
                        <a href="https://www.asancode.com/Account/ActiveCode/@Model.ActiveCode" style="padding: 8px 20px; outline: none; text-decoration: none; font-size: 16px; letter-spacing: 0.5px; transition: all 0.3s; font-weight: 600; border-radius: 6px; background-color:#009973; border: 1px solid #004d39; color: #ffffff;">تایید آدرس ایمیل</a>
                    </td>
                </tr>

                <tr>
                    <td style="padding: 16px 24px 0; color: #8492a6;">
                        این پیوند از زمان ارسال این ایمیل به مدت 6 ساعت فعال خواهد بود.
                    </td>
                </tr>

                <tr>
                    <td style="padding: 15px 24px 15px; color: #8492a6;">
                        <p>
                            با احترام
                            <br/>
                            مرکز پشتیبانی آسان کد
                        </p>
                        <p style="font-size: 16px;color: #004469">www.Asancode.com</p>
                    </td>
                </tr>

                <tr>
                    <td style="padding: 16px 8px; color: #8492a6; background-color: #f8f9fc; text-align: center;">
                        ©
                        <script>document.write(new Date().getFullYear())</script>2021 مجموعه آموزشی آسان کد.
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
    <!-- پایان آن -->


